# Ambiente 2 — Preview (local paralelo ou host cloud)
# Ver docs/infra/ENV_PREVIEW.md + npm run setup:ops-preview

DEPLOYMENT_TIER=preview

DATABASE_URL=postgresql://postgres:postgres123@127.0.0.1:5432/aiyracare_preview
API_PUBLIC_URL=http://127.0.0.1:3020
CRYPTO_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Ops preview — espelha prod com dados sintéticos
OPS_WORKER_MONITOR=1
CONNECT_WORKER_EXTERNAL=1
OPS_ALERTS_INTERVAL_MS=900000
# OPS_METRICS_KEY=                    # distinto da integração
# OPS_ALERT_WEBHOOK_URL=https://ntfy.sh/aiyracare-preview
# OPS_ALERT_DASHBOARD_URL=http://127.0.0.1:3023
# OPS_CONSOLE_PORT=3023
# OPS_LOCAL_NOTIFIER_PORT=3022

COMPLIANCE_GATE_ENABLED=0

# Subir stack: npm run up:preview
# Post-deploy: npm run preview:post-deploy
