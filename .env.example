# === DATABASE ===
DATABASE_URL=postgresql://user:password@host:5432/openhealth

# === INTEGRATION LINKS (obrigatório para sync Unimed/Amil/Mater Dei) ===
# 32 bytes em hex (64 caracteres). Gere: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRYPTO_KEY=

# Unimed BH — Playwright (default headless=true). Use false se APIs OutSystems não respondem.
UNIMED_HEADLESS=false
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password
# NEO4J_SYNC_ENABLED=0   # 1 = projeta entidades + lineage no grafo (default off em dev)
# NEO4J_READ_ENABLED=0     # 0 = desliga leituras (API graph/timeline) mesmo com sync on
# NEO4J_LINEAGE_BATCH_SIZE=100
# NEO4J_LINEAGE_INTERVAL_MS=300000

# === GCP ===
GCP_PROJECT_ID=open-health-project
GCP_SERVICE_ACCOUNT_KEY=path/to/key.json

# === API KEYS ===
OPENAI_API_KEY=sk-...
GROQ_API_KEY=...

# === SUPABASE AUTH (cloud: scripts/setup-env.ps1 -Cloud) ===
# SUPABASE_URL=https://lyljosprzmtapkocmxxa.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE=
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# GOOGLE_OAUTH_CLIENT_ID=   # Google Cloud Console — redirect no Supabase Auth
# GOOGLE_OAUTH_CLIENT_SECRET=
GEMINI_API_KEY=...
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_FREE_MODEL=gemini-2.5-flash
GEMINI_PREMIUM_MODEL=gemini-3.5-flash-lite
# GROQ_CHAT_MODEL=qwen/qwen3.6-27b
# OPENCODE_API_KEY=              # fallback para Zen/Go se chaves específicas vazias
# OPENCODE_ZEN_API_KEY=          # Zen pay-as-you-go — https://opencode.ai/zen/v1
# OPENCODE_ZEN_FREE_CHAT_MODEL=deepseek-v4-flash-free
# OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
# OPENCODE_GO_API_KEY=           # OpenCode Go ($10/mês) — alias Windows: OPENCODEGO_API_KEY
# OPENCODE_GO_CHAT_MODEL=deepseek-v4-flash
# OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1

# === LLM INTERNO (classificação de rótulos de operadora — custo operacional NOSSO) ===
# LLM_INTERNAL_CLASSIFY_LLM=0         # 1=habilita fallback LLM na classificação (default: on se Go/Gemini configurados)
# LLM_INTERNAL_ALLOW_ZEN_FREE=1       # permite Zen free (DeepSeek Free) — pode reter dados p/ melhorar modelo (LGPD: cuidado em produção)
# LLM_INTERNAL_MONTHLY_BUDGET_CENTS=10000  # teto mensal interno em centavos de R$ (10000 = R$100)
# LLM_INTERNAL_USD_BRL=5.2            # câmbio estimado USD→BRL para converter custo estimado
# LLM_INTERNAL_OBSERVABILITY_KEY=     # chave p/ GET /llm/usage/internal (se vazia, endpoint aberto p/ auth)
# LLM_INTERNAL_PRICE_OVERRIDE_JSON=   # opcional: {"<provider:model>":{"inputPer1MUsdCents":N,"outputPer1MUsdCents":N}}
# OPENAI_API_KEY=sk-...
# OPENAI_VISION_MODEL=gpt-4o-mini

# === OCR & MANUSCRITO ===
# OCR_ALLOW_PAID=0          # desliga Google Vision (fallback pago)
# HANDWRITING_INTERPRETATION_ENABLED=1
# HANDWRITING_MONTHLY_FREE=10
# HANDWRITING_CREDITS_SCOPE=default
# MATER_DEI_ALLOW_BROWSER=0   # default: só API/refresh; browser na 1ª vez ou sessão expirada
# MATER_DEI_CDP_URL=http://127.0.0.1:9222
# HERMES_PARDINI_REGION=mg          # legado Magento (não usado no sync de laudos)
# HERMES_PARDINI_HEADLESS=1         # 0 = Chromium visível no fallback browser
# HERMES_PARDINI_ALLOW_BROWSER=0    # 1 = permite browser se Keycloak ROPC falhar

# === CONNECT / SYNC SILENCIOSO ===
# SYNC_MIN_INTERVAL_MS=1800000     # API: não re-sync se último job OK < intervalo (default 30 min)
# SYNC_STREAM_HEARTBEAT_MS=25000   # SSE heartbeat no stream de progresso de sync
# AMIL_SESSION_RENEW_MS=86400000   # API: renovar JWT Amil via CDP quando expira em < 24h
# VITE_SILENT_SYNC_STALE_MS=21600000  # Web: auto-sync silencioso na Carteira se última sync > 6h

# === AGENT CONFIG ===
AGENT_PEDIATRIA_MODEL=gpt-4
AGENT_FARMACEUTICO_MODEL=gpt-4

# Franquia IA (dev/testes) — LLM_QUOTA_UNLIMITED=1 desativa limite para todas as contas
# LLM_QUOTA_BYPASS_EMAILS=rafael@example.com
# LLM_QUOTA_BYPASS_ACCOUNT_IDS=

# === LEGAL / LGPD / GO-LIVE ===
# Razão social e CNPJ exibidos nos documentos legais (14 dígitos, só números)
# LEGAL_ENTITY_NAME=
# LEGAL_CNPJ=
# LEGAL_PRIVACY_EMAIL=privacidade@exemplo.com
# LEGAL_SUPPORT_EMAIL=suporte@exemplo.com
# LEGAL_DPO_SLA_DAYS=15
# COMPLIANCE_GATE_ENABLED=0   # 1 em produção — bloqueia app até aceite dos termos vigentes
# LEGAL_CONTENT_ADAPTER=fs    # fs | http | gcs — ver docs/LEGAL_COMPLIANCE.md
# LEGAL_CMS_BASE_URL=         # adapter http: base URL dos markdowns
# LEGAL_CMS_GCS_BUCKET=       # adapter gcs
# LEGAL_CMS_GCS_PREFIX=legal

# === GOOGLE CALENDAR (agenda OAuth) ===
# Reutiliza GOOGLE_OAUTH_* do Supabase se GOOGLE_CALENDAR_* não definidos
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:3010/calendar/google/oauth/callback
# API_PUBLIC_URL=http://127.0.0.1:3010

# === MICROSOFT OUTLOOK CALENDAR (agenda OAuth) ===
# App Azure (pode ser o mesmo do login Supabase) + redirect da API, não só Supabase
# MICROSOFT_CALENDAR_CLIENT_ID=
# MICROSOFT_CALENDAR_CLIENT_SECRET=
# MICROSOFT_CALENDAR_REDIRECT_URI=http://localhost:3010/calendar/microsoft/oauth/callback
# Alternativa: AZURE_CLIENT_ID / AZURE_CLIENT_SECRET ou MICROSOFT_OAUTH_*

# === STRIPE (billing) ===
# Runtime da API (packages/api) — não commitar valores reais:
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PACK_10=price_...      # test sandbox exemplo: price_1U5SfoC13WtRzmy67c4MZPbs (R$29)
# STRIPE_PRICE_PACK_30=price_...      # test sandbox exemplo: price_1U5SfpC13WtRzmy6GOAZMnTY (R$69)
# STRIPE_PRICE_FAMILY_MONTHLY=price_... # test sandbox exemplo: price_1U5SfrC13WtRzmy6o5ILX9Wt (R$19,90/mês)
# BILLING_FAMILY_MONTHLY_CENTS=1990
# BILLING_FREE_MONTHLY_FREE=10
# BILLING_EXPORT_ACCOUNT_IDS=   # UUID(s) conta operador — export CSV na UI
# Cursor MCP Stripe (agente) — variáveis de ambiente do sistema, não lidas pela API:
# STRIPE_AGENT_KEY=...
# STRIPE_AGENT_TOKEN=...
