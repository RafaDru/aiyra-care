{
  "expo": {
    "name": "Ananeri",
    "slug": "aiyracare",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "aiyracare",
    "userInterfaceStyle": "light",
    "android": {
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "ios": {
      "infoPlist": {
        "NSFaceIDUsageDescription": "O Ananeri usa Face ID para desbloquear o app com segurança."
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir que o Ananeri use Face ID para desbloquear o app."
        }
      ]
    ]
  }
}
