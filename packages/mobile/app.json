{
  "expo": {
    "name": "Ananeri",
    "slug": "aiyracare",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "aiyracare",
    "userInterfaceStyle": "light",
    "icon": "./assets/brand/logo-square.png",
    "splash": {
      "image": "./assets/brand/logo-square.png",
      "resizeMode": "contain",
      "backgroundColor": "#7E22CE"
    },
    "android": {
      "package": "br.com.ananeri.preview",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/logo-square.png",
        "backgroundColor": "#7E22CE"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "ios": {
      "bundleIdentifier": "br.com.ananeri.preview",
      "infoPlist": {
        "NSFaceIDUsageDescription": "O Ananeri usa Face ID para desbloquear o app com segurança."
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir que o Ananeri use Face ID para desbloquear o app."
        }
      ]
    ]
  }
}
