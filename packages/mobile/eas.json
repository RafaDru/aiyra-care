{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ananeri-preview-api-kzp5ynymva-uc.a.run.app",
        "EXPO_PUBLIC_WEB_APP_URL": "https://ananeri-preview-web-kzp5ynymva-uc.a.run.app",
        "EXPO_PUBLIC_DEPLOYMENT_TIER": "preview"
      }
    },
    "preview-aab": {
      "extends": "preview",
      "distribution": "store",
      "channel": "preview",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "preview-aab": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}