# Copie para `.env` na raiz de packages/mobile (não commitar `.env`).
# Espelhe as chaves do web: VITE_SUPABASE_* → EXPO_PUBLIC_SUPABASE_* (ver docs/SUPABASE.md).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Emulador no PC: 127.0.0.1 OK. Celular físico (Expo Go): use IP LAN da máquina — nunca localhost.
EXPO_PUBLIC_API_URL=http://192.168.0.0:3010

# Bridge OAuth Google → web `/mobile-oauth-return` (mesmo IP que a API, porta 5173).
EXPO_PUBLIC_WEB_APP_URL=http://192.168.0.0:5173
EXPO_PUBLIC_OAUTH_REDIRECT_URI=http://192.168.0.0:5173/mobile-oauth-return

# `npm run mobile:lan` sobrescreve API/WEB/OAUTH com o IP detectado na Wi‑Fi.
