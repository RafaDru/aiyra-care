# Copie para `.env` na raiz de packages/mobile (não commitar `.env`).
# Espelhe as chaves do web: VITE_SUPABASE_* → EXPO_PUBLIC_SUPABASE_* (ver docs/SUPABASE.md).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# BFF local (web proxy usa o mesmo host em dev)
EXPO_PUBLIC_API_URL=http://127.0.0.1:3010

# Dispositivo físico: use o IP da máquina na LAN, ex. http://192.168.1.10:3010
