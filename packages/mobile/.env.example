# Copie para `.env` na raiz de packages/mobile (não commitar `.env`).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Celular físico: IP LAN da máquina (nunca localhost).
EXPO_PUBLIC_API_URL=http://192.168.0.0:3010
EXPO_PUBLIC_WEB_APP_URL=http://192.168.0.0:5173

# OAuth Google Expo Go: padrão bridge http://<LAN>:5173/mobile-oauth-return (Custom Tabs).
# Forçar exp://: EXPO_PUBLIC_OAUTH_USE_EXP_REDIRECT=1
# Supabase site_url LAN: node scripts/patch-supabase-auth-redirect-urls.mjs

# `npm run mobile:lan` força API LAN + REACT_NATIVE_PACKAGER_HOSTNAME; não usa bridge OAuth.
