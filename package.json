{
  "name": "aiyra-care",
  "version": "0.1.0",
  "private": true,
  "description": "AiyraCare - Gerenciamento centralizado de hist\u00F3rico m\u00E9dico infantil",
  "scripts": {
    "api:dev": "cd packages/api && npm run dev",
    "web:dev": "cd packages/web && npm run dev",
    "mobile:start": "cd packages/mobile && npx expo start",
    "agent:pediatria": "cd packages/agents/pediatria && python -m uvicorn main:app --reload",
    "agent:integracao": "cd packages/agents/integracao && python -m uvicorn main:app --reload",
    "agent:farmaceutico": "cd packages/agents/farmaceutico && python -m uvicorn main:app --reload",
    "lint": "echo 'linting'",
    "test": "echo 'tests'",
    "connect-worker": "cd packages/connect-worker && npm run start",
    "connect-worker:once": "cd packages/connect-worker && npm run once",
    "connect-worker:ops-alerts": "cd packages/connect-worker && npm run ops-alerts:once",
    "ops:metrics": "cd packages/api && npm run ops:metrics",
    "ops:alerts-check": "cd packages/api && npm run ops:alerts-check",
    "ops:triage": "cd packages/api && npm run ops:triage",
    "ops:probe": "cd packages/api && npm run ops:probe",
    "ops:console": "cd packages/ops-console && npm run dev",
    "ops:console:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ops-console-up.ps1",
    "ops:console:watch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ops-console-up.ps1 -Watch",
    "stack:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/aiyracare-stack.ps1 -Action status",
    "stack:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/aiyracare-stack.ps1 -Action start",
    "stack:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/aiyracare-stack.ps1 -Action stop",
    "stack:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/aiyracare-stack.ps1 -Action restart",
    "ops:smoke": "cd packages/api && npm run ops:smoke",
    "test:ops": "cd packages/api && npm run test:ops",
    "ops:local-notifier": "powershell -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File scripts/ops-local-notifier-tray.ps1",
    "ops:notifier:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ops-notifier-up.ps1",
    "ops:notifier:simulate": "cd packages/api && npm run ops:notifier:simulate",
    "setup:ops-prod": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-ops-prod.ps1",
    "setup:ops-preview": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-ops-preview.ps1",
    "setup:ops-alerts": "powershell -File scripts/setup-ops-alerts.ps1",
    "neo4j-lineage-worker": "cd packages/neo4j-lineage-worker && npm run start",
    "neo4j-lineage-worker:once": "cd packages/neo4j-lineage-worker && npm run once",
    "neo4j-lineage-worker:backfill": "cd packages/neo4j-lineage-worker && npm run backfill",
    "seed:demo": "cd packages/api && npm run seed:demo",
    "seed:staging-refresh": "cd packages/api && npm run seed:staging-refresh",
    "link:demo-patients": "cd packages/api && npm run link:demo-patients",
    "promotion:gates": "node scripts/run-promotion-gates.mjs",
    "up:preview": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/up-preview.ps1",
    "move:workspace": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/move-to-workspace.ps1",
    "move:workspace:copy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/move-to-workspace.ps1 -CopyOnly",
    "migrate:cursor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/migrate-cursor-workspace.ps1",
    "finalize:consolidation": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/finalize-consolidation.ps1",
    "preview:post-deploy": "node scripts/preview-post-deploy.mjs",
    "preview:validate": "node scripts/preview-validate-local.mjs",
    "hosts:register": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-local-hosts.ps1",
    "caddy:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/caddy-local.ps1",
    "caddy:local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/caddy-local.ps1 -Stop",
    "env:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/env-status.ps1",
    "validate:env-tier": "node scripts/validate-env-tier.mjs",
    "validate:ops-dual-keys": "node scripts/validate-ops-dual-keys.mjs",
    "dev-audit:bridge": "cd packages/api && npm run dev-audit:bridge",
    "migrate:pg-names": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/migrate-pg-names-to-aiyracare.ps1",
    "migrate:session": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/migrate-session-to-aiyra-care.ps1",
    "fix:workspace": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fix-aiyra-care-workspace.ps1"
  },
  "workspaces": [
    "packages/*",
    "packages/agents/*"
  ]
}
