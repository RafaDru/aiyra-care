{
  "name": "open-health",
  "version": "0.1.0",
  "private": true,
  "description": "Open Health - Gerenciamento centralizado de hist\u00F3rico m\u00E9dico infantil",
  "scripts": {
    "api:dev": "cd packages/api && npm run dev",
    "web:dev": "cd packages/web && npm run dev",
    "mobile:start": "cd packages/mobile && npx expo start",
    "agent:pediatria": "cd packages/agents/pediatria && python -m uvicorn main:app --reload",
    "agent:integracao": "cd packages/agents/integracao && python -m uvicorn main:app --reload",
    "agent:farmaceutico": "cd packages/agents/farmaceutico && python -m uvicorn main:app --reload",
    "lint": "echo 'linting'",
    "test": "echo 'tests'",
    "connect-worker": "cd packages/connect-worker && npm run start",
    "connect-worker:once": "cd packages/connect-worker && npm run once",
    "connect-worker:ops-alerts": "cd packages/connect-worker && npm run ops-alerts:once",
    "ops:metrics": "cd packages/api && npm run ops:metrics",
    "ops:alerts-check": "cd packages/api && npm run ops:alerts-check",
    "ops:triage": "cd packages/api && npm run ops:triage",
    "ops:probe": "cd packages/api && npm run ops:probe",
    "ops:console": "cd packages/ops-console && npm run dev",
    "ops:console:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ops-console-up.ps1",
    "ops:console:watch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ops-console-up.ps1 -Watch",
    "stack:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/aiyracare-stack.ps1 -Action status",
    "stack:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/aiyracare-stack.ps1 -Action start",
    "stack:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/aiyracare-stack.ps1 -Action stop",
    "stack:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/aiyracare-stack.ps1 -Action restart",
    "ops:smoke": "cd packages/api && npm run ops:smoke",
    "ops:local-notifier": "powershell -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File scripts/ops-local-notifier-tray.ps1",
    "ops:notifier:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ops-notifier-up.ps1",
    "setup:ops-alerts": "powershell -File scripts/setup-ops-alerts.ps1",
    "neo4j-lineage-worker": "cd packages/neo4j-lineage-worker && npm run start",
    "neo4j-lineage-worker:once": "cd packages/neo4j-lineage-worker && npm run once",
    "neo4j-lineage-worker:backfill": "cd packages/neo4j-lineage-worker && npm run backfill"
  },
  "workspaces": [
    "packages/*",
    "packages/agents/*"
  ]
}
