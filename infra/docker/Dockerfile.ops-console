# Ops console — usa código da API em runtime (tsx)
FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV OPS_CONSOLE_PORT=8080
ENV OPS_CONSOLE_HOST=0.0.0.0

COPY package.json package-lock.json ./
COPY packages/api/package.json packages/api/
COPY packages/connect/package.json packages/connect/
COPY packages/ops-console/package.json packages/ops-console/

RUN npm ci --workspace=@aiyra-care/ops-console --workspace=@aiyra-care/api --workspace=@aiyra-care/connect

COPY packages/connect packages/connect
COPY packages/api packages/api
COPY packages/ops-console packages/ops-console

WORKDIR /app/packages/ops-console
RUN npm run build

EXPOSE 8080
CMD ["npx", "tsx", "src/server.ts"]
