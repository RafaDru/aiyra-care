# API AiyraCare — preview/prod (monorepo; tsx em runtime por workspace connect)
FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8080

COPY package.json package-lock.json ./
COPY packages/api/package.json packages/api/
COPY packages/connect/package.json packages/connect/

RUN npm ci --workspace=@aiyra-care/api --workspace=@aiyra-care/connect

COPY packages/connect packages/connect
COPY packages/api packages/api
COPY database/relational database/relational

EXPOSE 8080
CMD ["npx", "tsx", "packages/api/src/index.ts"]
