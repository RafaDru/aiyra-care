# API AiyraCare — preview/prod (monorepo; tsx em runtime por workspace connect)
FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV PORT=8080

COPY package.json package-lock.json ./
COPY packages/api/package.json packages/api/
COPY packages/connect/package.json packages/connect/

RUN npm ci --workspace=@ananeri/api --workspace=@ananeri/connect

COPY packages/connect packages/connect
COPY packages/api packages/api
COPY database/relational database/relational
COPY tsconfig.base.json ./

RUN npm run build --workspace=@ananeri/connect

ENV NODE_ENV=production

EXPOSE 8080
CMD ["npx", "tsx", "packages/api/src/index.ts"]
