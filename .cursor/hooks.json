{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/session-start.mjs"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/before-shell.mjs"
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/after-file-edit.mjs"
      }
    ],
    "preToolUse": [
      {
        "command": "node .cursor/hooks/pre-tool-guard.mjs",
        "matcher": "Write|StrReplace|Delete",
        "failClosed": false
      }
    ]
  }
}
